{
	"cleanUrls": false,
	"rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
	"headers": [
		{ "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
		{ "source": "/_app/immutable/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
	]
}
