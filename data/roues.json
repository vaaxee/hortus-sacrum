  {
   "id": "commandements",
   "nombre": 10,
   "titre": "Les dix commandements de Dieu",
   "elements": [
    {
     "fr": "Un seul Dieu tu adoreras",
     "la": "Non habebis deos alienos coram me"
    },
    {
     "fr": "Le nom de Dieu tu ne prendras pas en vain",
     "la": "Non assumes nomen Domini Dei tui in vanum"
    },
    {
     "fr": "Le jour du Seigneur tu sanctifieras",
     "la": "Memento ut diem sabbati sanctifices"
    },
    {
     "fr": "Tes père et mère tu honoreras",
     "la": "Honora patrem tuum et matrem tuam"
    },
    {
     "fr": "Tu ne tueras point",
     "la": "Non occides"
    },
    {
     "fr": "Tu ne commettras point d’impureté",
     "la": "Non mœchaberis"
    },
    {
     "fr": "Tu ne voleras point",
     "la": "Non furtum facies"
    },
    {
     "fr": "Tu ne porteras point de faux témoignage",
     "la": "Non loqueris contra proximum tuum falsum testimonium"
    },
    {
     "fr": "Tu ne désireras point la femme de ton prochain",
     "la": "Non desiderabis uxorem ejus"
    },
    {
     "fr": "Tu ne désireras point le bien d’autrui",
     "la": "Non concupisces domum proximi tui"
    }
   ],
